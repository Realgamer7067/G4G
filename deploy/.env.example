# Copy to `deploy/.env` (next to docker-compose.yml) and fill in. Never commit the filled-in copy.

# Public hostname. Point its DNS A/AAAA record at this server before the first start;
# Caddy then obtains a Let's Encrypt certificate automatically. Use `localhost` to try the stack locally.
DOMAIN=gfg.example.edu

# Database password. Use only letters and digits (it is embedded in a URL), e.g. `openssl rand -hex 24`.
POSTGRES_PASSWORD=

# First super admin, created by the seed on first start. The password must meet the app's policy.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
# Set to 1 for one start to reset the super admin's password/role from the two values above, then back to 0.
SEED_RESET_SUPERADMIN=0
