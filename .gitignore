# dependencies
node_modules/
.pnp
.pnp.*

# next.js / build — anchored so nested route folders named "build" (e.g. admin/forms/[id]/build) aren't ignored
.next/
out/
/build/
next-env.d.ts
*.tsbuildinfo

# generated
src/generated/

# env files (only the example is committed)
.env
.env.*
!.env.example
!deploy/.env.example

# runtime data (uploads) — anchored so src/lib/data is not ignored
/data/

# testing
coverage/
playwright-report/
test-results/

# misc
.DS_Store
*.pem
*.log
npm-debug.log*
.prisma-dev/
.vercel

# deployment backups (contain the database and uploads)
/deploy/backups/
